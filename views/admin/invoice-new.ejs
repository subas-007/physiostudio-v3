<div class="page-head"><h1>New invoice</h1></div>
<form method="post" action="/admin/invoices/new" class="card form" data-invoice>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (appointment) { %><input type="hidden" name="appointment_id" value="<%= appointment.id %>"><p class="alert alert-info">For appointment <%= appointment.ref %> on <%= u.fmtDate(appointment.date) %>.</p><% } %>
  <fieldset><legend>Patient</legend>
    <div class="patient-picker" data-patient-picker>
      <input type="hidden" name="patient_id" value="<%= patient ? patient.id : '' %>" data-patient-id required>
      <div class="picked" data-picked <%= patient ? '' : 'hidden' %>><span data-picked-label><%= patient ? patient.full_name + ' · ' + patient.patient_code + ' · ' + patient.phone : '' %></span> <% if (!appointment) { %><button type="button" class="linklike" data-clear>change</button><% } %></div>
      <div data-search-wrap <%= patient ? 'hidden' : '' %>><label>Find patient<input type="search" data-patient-search placeholder="Type name, phone or ID…" autocomplete="off"></label><ul class="ac-list" data-ac hidden></ul></div>
    </div>
    <div class="row2"><label>Invoice date<input type="date" name="issue_date" value="<%= today %>"></label><label>Due date <small class="muted">(optional)</small><input type="date" name="due_date"></label></div>
  </fieldset>
  <fieldset><legend>Items</legend>
    <table class="table items"><thead><tr><th>Service / description</th><th class="w-qty">Qty</th><th class="w-price">Unit price</th><th class="num w-price">Amount</th><th></th></tr></thead>
      <tbody data-items>
        <% (items.length ? items : [{}]).forEach(function(it){ %>
        <tr data-item>
          <td><select data-item-service name="item_service"><option value="">Custom item…</option><% services.forEach(function(sv){ %><option value="<%= sv.id %>" data-price="<%= sv.price %>" data-title="<%= sv.title %>" <%= String(it.service_id) === String(sv.id) ? 'selected' : '' %>><%= sv.title %></option><% }) %></select>
            <input name="item_description" value="<%= it.description || '' %>" placeholder="Description" required maxlength="200" data-item-desc></td>
          <td><input type="number" name="item_qty" value="<%= it.qty || 1 %>" min="0.5" step="0.5" data-item-qty></td>
          <td><input type="number" name="item_price" value="<%= it.unit_price != null ? it.unit_price : '' %>" min="0" step="0.01" data-item-price required></td>
          <td class="num" data-item-total>0.00</td><td><button type="button" class="linklike" data-remove-item aria-label="Remove line">✕</button></td>
        </tr><% }) %>
      </tbody></table>
    <button type="button" class="btn btn-sm btn-ghost" data-add-item>+ Add line</button>
    <div class="totals">
      <div><span>Subtotal</span><strong data-subtotal>0.00</strong></div>
      <div><label>Discount (Rs.)<input type="number" name="discount" value="0" min="0" step="0.01" data-discount></label></div>
      <div><span><%= s.tax_label %> <%= s.tax_rate %>%</span><strong data-tax data-rate="<%= s.tax_rate %>">0.00</strong></div>
      <div class="grand"><span>Total</span><strong data-total>0.00</strong></div>
    </div>
  </fieldset>
  <fieldset><legend>Payment now (optional)</legend>
    <div class="row3"><label>Amount received<input type="number" name="pay_amount" min="0" step="0.01" data-pay-amount></label>
      <label>Method<select name="pay_method"><% METHODS.forEach(function(m){ %><option value="<%= m %>"><%= m %></option><% }) %></select></label>
      <label>Reference<input name="pay_reference" maxlength="100" placeholder="eSewa/Khalti txn ID, card slip…"></label></div>
    <button type="button" class="btn btn-sm btn-ghost" data-pay-full>Paid in full</button>
  </fieldset>
  <label>Notes on invoice<textarea name="notes" rows="2" maxlength="1000"></textarea></label>
  <button class="btn btn-primary">Create invoice</button>
</form>
