<div class="page-head"><h1>Appointments</h1><div class="actions"><a class="btn btn-ghost" href="/admin/appointments">Day view</a><a class="btn btn-primary" href="/admin/appointments/new">+ New</a></div></div>
<form method="get" class="filters card">
  <input type="hidden" name="view" value="list">
  <label>From<input type="date" name="from" value="<%= f.from %>"></label><label>To<input type="date" name="to" value="<%= f.to %>"></label>
  <label>Status<select name="status"><option value="">All</option><% STATUSES.forEach(function(st){ %><option value="<%= st %>" <%= f.status === st ? 'selected' : '' %>><%= st.replace('_',' ') %></option><% }) %></select></label>
  <label>Therapist<select name="staff_id"><option value="">All</option><% staffList.forEach(function(m){ %><option value="<%= m.id %>" <%= String(f.staff_id) === String(m.id) ? 'selected' : '' %>><%= m.full_name %></option><% }) %></select></label>
  <label>Search<input type="search" name="q" value="<%= f.q %>" placeholder="Name, phone, ref"></label>
  <button class="btn btn-ghost">Filter</button>
</form>
<div class="card"><table class="table"><thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Service</th><th>Therapist</th><th>Source</th><th>Status</th><th>Ref</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="8" class="muted">No appointments match.</td></tr><% } %>
<% rows.forEach(function(a){ %><tr><td><%= u.fmtDate(a.date) %></td><td><%= u.fmtTime(a.start_time) %></td><td><a href="/admin/patients/<%= a.patient_id %>"><%= a.patient_name %></a><br><small class="muted"><%= a.patient_phone %></small></td><td><%= a.service_title %></td><td><%= a.staff_name %></td><td><%= a.source %></td><td><span class="badge badge-<%= a.status %>"><%= a.status.replace('_',' ') %></span></td><td><a href="/admin/appointments/<%= a.id %>"><%= a.ref %></a></td></tr><% }) %>
</tbody></table><%- include('../partials/pager', { pg, query: f }) %></div>
