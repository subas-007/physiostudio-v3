<div class="page-head"><h1>Media library</h1></div>
<form method="post" action="/admin/cms/media?_csrf=<%= csrf %>" enctype="multipart/form-data" class="card form inline-form">
  <label>Image (JPG/PNG/WEBP/GIF, max 5 MB)<input type="file" name="file" required accept="image/jpeg,image/png,image/webp,image/gif"></label><label>Alt text<input name="alt" maxlength="200"></label><button class="btn btn-primary">Upload</button>
</form>
<div class="media-grid">
  <% if (!items.length) { %><p class="muted">No uploads yet. Photos migrated from the old website are referenced directly by their /uploads/... path.</p><% } %>
  <% items.forEach(function(m){ %><figure class="card media"><img src="<%= m.path %>" alt="<%= m.alt || '' %>" loading="lazy"><figcaption><input readonly value="<%= m.path %>" data-select-all><small class="muted"><%= Math.round(m.size/1024) %> KB · <%= m.created_at %></small>
    <form method="post" action="/admin/cms/media/<%= m.id %>/delete" data-confirm="Delete this image? Pages using it will show a broken image."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike danger">Delete</button></form></figcaption></figure><% }) %>
</div>
