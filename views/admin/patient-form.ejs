<div class="page-head"><h1><%= title %></h1></div>
<form method="post" class="card form" action="<%= isNew ? '/admin/patients/new' : '/admin/patients/' + f.id + '/edit' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset><legend>Personal details</legend>
    <div class="row3"><label>Full name *<input name="full_name" required maxlength="120" value="<%= f.full_name || '' %>"></label>
      <label>Gender<select name="gender"><option value="">—</option><% ['Female','Male','Other'].forEach(function(g){ %><option <%= f.gender === g ? 'selected' : '' %>><%= g %></option><% }) %></select></label>
      <label>Date of birth<input type="date" name="date_of_birth" value="<%= f.date_of_birth || '' %>"></label></div>
    <div class="row3"><label>Mobile *<input type="tel" name="phone" required maxlength="20" value="<%= f.phone || '' %>"></label><label>WhatsApp<input type="tel" name="whatsapp" maxlength="20" value="<%= f.whatsapp || '' %>"></label><label>Email<input type="email" name="email" maxlength="190" value="<%= f.email || '' %>"></label></div>
    <div class="row3"><label>Address<input name="address" maxlength="300" value="<%= f.address || '' %>"></label><label>Occupation<input name="occupation" maxlength="120" value="<%= f.occupation || '' %>"></label><label>Referred by<input name="referred_by" maxlength="200" value="<%= f.referred_by || '' %>"></label></div>
    <div class="row2"><label>Emergency contact name<input name="emergency_contact_name" maxlength="120" value="<%= f.emergency_contact_name || '' %>"></label><label>Emergency contact phone<input type="tel" name="emergency_contact_phone" maxlength="20" value="<%= f.emergency_contact_phone || '' %>"></label></div>
  </fieldset>
  <fieldset><legend>Medical background</legend>
    <label>Medical / surgical history<textarea name="medical_history" rows="3"><%= f.medical_history || '' %></textarea></label>
    <div class="row2"><label>Allergies<textarea name="allergies" rows="2"><%= f.allergies || '' %></textarea></label><label>Current medications<textarea name="current_medications" rows="2"><%= f.current_medications || '' %></textarea></label></div>
  </fieldset>
  <fieldset><legend>Consent &amp; communication</legend>
    <label class="check"><input type="checkbox" name="consent_treatment" value="1" <%= f.consent_treatment ? 'checked' : '' %>> Patient consents to assessment, treatment and record keeping</label>
    <label class="check"><input type="checkbox" name="consent_communication" value="1" <%= f.consent_communication ? 'checked' : '' %>> Patient consents to appointment messages</label>
    <label class="check"><input type="checkbox" name="notify_email" value="1" <%= f.notify_email ? 'checked' : '' %>> Email reminders</label>
    <label class="check"><input type="checkbox" name="notify_whatsapp" value="1" <%= f.notify_whatsapp ? 'checked' : '' %>> WhatsApp reminders</label>
  </fieldset>
  <button class="btn btn-primary"><%= isNew ? 'Register patient' : 'Save changes' %></button> <a class="btn btn-ghost" href="<%= isNew ? '/admin/patients' : '/admin/patients/' + f.id %>">Cancel</a>
</form>
