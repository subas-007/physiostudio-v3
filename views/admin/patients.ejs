<div class="page-head"><h1>Patients</h1><div class="actions"><a class="btn btn-ghost" href="?archived=<%= archived ? 0 : 1 %>"><%= archived ? 'Active patients' : 'Archived' %></a><% if (can('patients.manage')) { %><a class="btn btn-primary" href="/admin/patients/new">+ Register patient</a><% } %></div></div>
<form method="get" class="filters card"><input type="hidden" name="archived" value="<%= archived %>"><label class="grow">Search<input type="search" name="q" value="<%= q %>" placeholder="Name, phone, email or patient ID" autofocus></label><button class="btn btn-ghost">Search</button></form>
<div class="card"><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Phone</th><th>Email</th><th>Age</th><th class="num">Visits</th><th>Last visit</th><th>Portal</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="8" class="muted">No patients found.</td></tr><% } %>
<% rows.forEach(function(p){ %><tr><td><a href="/admin/patients/<%= p.id %>"><%= p.patient_code %></a></td><td><a href="/admin/patients/<%= p.id %>"><strong><%= p.full_name %></strong></a></td><td><%= p.phone %></td><td><%= p.email || '' %></td><td><%= u.ageFrom(p.date_of_birth) %></td><td class="num"><%= p.visits %></td><td><%= p.last_visit ? u.fmtDate(p.last_visit) : '—' %></td><td><%= p.user_id ? '✓' : '' %></td></tr><% }) %>
</tbody></table><%- include('../partials/pager', { pg, query: { q, archived } }) %></div>
