<div class="page-head"><h1>Holidays &amp; leave</h1><p class="muted">Closed days and therapist leave are removed from online booking automatically.</p></div>
<form method="post" action="/admin/holidays" class="card form inline-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>From<input type="date" name="date" required></label><label>To <small class="muted">(optional)</small><input type="date" name="to"></label>
  <label>Who<select name="staff_id"><option value="">Whole clinic (public holiday)</option><% staffList.forEach(function(m){ %><option value="<%= m.id %>"><%= m.full_name %> (leave)</option><% }) %></select></label>
  <label>Reason<input name="reason" maxlength="200" placeholder="e.g. Dashain"></label><button class="btn btn-primary">Add</button>
</form>
<div class="card"><table class="table"><thead><tr><th>Date</th><th>Who</th><th>Reason</th><th></th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="4" class="muted">None scheduled.</td></tr><% } %>
<% rows.forEach(function(r){ %><tr><td><%= u.fmtDate(r.date) %></td><td><%= r.full_name || 'Whole clinic' %></td><td><%= r.reason || '' %></td><td><form method="post" action="/admin/holidays/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike danger">Remove</button></form></td></tr><% }) %>
</tbody></table></div>
