<!doctype html><html lang="en"><head><meta charset="utf-8"><title><%= title %></title><link rel="stylesheet" href="/static/css/print.css"></head>
<body class="print-doc"><div class="no-print bar"><button data-print>Print / Save as PDF</button></div>
<header class="doc-head"><img src="<%= s.logo %>" alt="" height="48"><div><h1>Patient clinical record</h1><p><%= s.clinic_name %> · <%= s.address %> · <%= s.phone_primary %></p></div></header>
<p class="confidential">CONFIDENTIAL – contains personal health information. Printed <%= new Date().toLocaleString('en-GB') %> by <%= user.full_name %>.</p>
<table class="kv"><tr><th>Patient</th><td><%= p.full_name %> (<%= p.patient_code %>)</td><th>DOB / Age</th><td><%= p.date_of_birth || '—' %> <%= p.date_of_birth ? '(' + u.ageFrom(p.date_of_birth) + ')' : '' %></td></tr>
<tr><th>Gender</th><td><%= p.gender || '—' %></td><th>Phone</th><td><%= p.phone %></td></tr>
<tr><th>Allergies</th><td colspan="3"><%= p.allergies || 'None recorded' %></td></tr><tr><th>History</th><td colspan="3"><%= p.medical_history || '—' %></td></tr><tr><th>Medications</th><td colspan="3"><%= p.current_medications || '—' %></td></tr></table>
<h2>Visits</h2><table class="lines"><thead><tr><th>Date</th><th>Time</th><th>Service</th><th>Therapist</th><th>Status</th></tr></thead><tbody><% appts.forEach(function(a){ %><tr><td><%= a.date %></td><td><%= a.start_time %></td><td><%= a.service_title %></td><td><%= a.staff_name %></td><td><%= a.status %></td></tr><% }) %></tbody></table>
<h2>Clinical notes</h2>
<% notes.forEach(function(n){ %><section class="note"><h3><%= n.note_type.replace('_',' ') %> · <%= n.created_at %> · <%= n.author %> <%= n.is_locked ? '(signed)' : '(DRAFT)' %><% if (n.pain_score != null) { %> · Pain <%= n.pain_score %>/10<% } %></h3>
<% [['Subjective','subjective'],['Objective','objective'],['Assessment','assessment'],['Plan','plan']].forEach(function(k){ if (n[k[1]]) { %><p><b><%= k[0] %>:</b> <%= n[k[1]] %></p><% } }) %></section><% }) %>
<script src="/static/js/print.js"></script></body></html>
