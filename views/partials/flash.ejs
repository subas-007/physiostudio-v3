<% (flashes || []).forEach(function(f){ %><div class="alert alert-<%= f.type %>" role="status"><%= f.msg %></div><% }) %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<% if (typeof errors !== 'undefined' && errors && errors.length) { %><div class="alert alert-error" role="alert"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
