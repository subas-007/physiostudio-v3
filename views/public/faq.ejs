<header class="page-head"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Questions</nav><h1>Questions people ask</h1></div></header>
<section class="band band-tight"><div class="wrap ask">
  <div>
    <label class="search-field">Search questions<input type="search" data-faq-search placeholder="e.g. payment, referral, what to wear" autocomplete="off"></label>
    <div class="faq" data-faq><% faqs.forEach(function(f){ %><details><summary><%= f.question %></summary><p><%= f.answer %></p></details><% }) %></div>
    <p class="empty" data-faq-empty hidden>No questions match. Try another word, or ask us directly.</p>
  </div>
  <%- include('../partials/callback') %>
</div></section>
