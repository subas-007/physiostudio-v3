# ---------- Core ----------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1                     # keep app behind Nginx; don't expose Node directly
BASE_URL=https://physiostudio.com.np
TZ=Asia/Kathmandu
TRUST_PROXY=1
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
APP_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_64_RANDOM_CHARS   # encrypts staff 2FA secrets at rest – back it up!
DATA_DIR=/var/lib/physiostudio/data
UPLOAD_DIR=/var/lib/physiostudio/uploads
LEGACY_ASSET_BASE=https://physiostudio.com.np   # fallback for photos not yet imported

# First admin (used only when the database is empty)
ADMIN_EMAIL=admin@physiostudio.com.np
# ADMIN_PASSWORD=   # leave unset to auto-generate and print once

# ---------- Email (SMTP) ----------
# Gmail/Google Workspace: smtp.gmail.com, 587, use an App Password. Or Zoho, SendGrid, Mailgun, Amazon SES…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Physio Studio <no-reply@physiostudio.com.np>"
CLINIC_NOTIFY_EMAIL=tophysio.studio@gmail.com   # receives contact-form alerts

# ---------- WhatsApp ----------
# Option A: Meta WhatsApp Cloud API (official, cheapest).  WHATSAPP_PROVIDER=meta
# Option B: Twilio WhatsApp.                                 WHATSAPP_PROVIDER=twilio
WHATSAPP_PROVIDER=
META_WA_PHONE_NUMBER_ID=
META_WA_TOKEN=
META_GRAPH_VERSION=v21.0
WA_TEMPLATE_LANG=en
# Approved template names (body params: {{1}} name, {{2}} date, {{3}} time, {{4}} therapist)
WA_TEMPLATE_CONFIRMED=appointment_confirmed
WA_TEMPLATE_REMINDER_24H=appointment_reminder
WA_TEMPLATE_REMINDER_2H=appointment_reminder_today
WA_TEMPLATE_RESCHEDULED=appointment_rescheduled
WA_TEMPLATE_CANCELLED=appointment_cancelled
WA_TEMPLATE_BOOKING_RECEIVED=appointment_received
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
